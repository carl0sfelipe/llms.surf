{
  "kind": "p1-vectors/1",
  "note": "Shared conformance vectors for kernel P1 (dispatch policy). Consumed by the Rust crate (tests/vectors.rs) and by the Bend lab. Each case = inputs + expected resolution. Add a case for every incident; never delete one.",
  "fixtures": {
    "registry": {
      "models": [
        {"id": "nemotron-3-ultra-free", "provider": "zen", "tier": "free", "id_status": "EXISTE"},
        {"id": "mimo-v2.5-free", "provider": "zen", "tier": "free", "id_status": "EXISTE"},
        {"id": "google/gemma-4-31b-it:free", "provider": "openrouter", "tier": "free", "id_status": "EXISTE"},
        {"id": "cohere/north-mini-code:free", "provider": "openrouter", "tier": "free", "id_status": "EXISTE"},
        {"id": "ghost-model:free", "provider": "openrouter", "tier": "free", "id_status": "FANTASMA"},
        {"id": "deepseek-v4-pro", "provider": "deepseek", "tier": "paid", "id_status": "EXISTE", "fallback": ["deepseek-v4-flash-openrouter"]},
        {"id": "deepseek-v4-flash-openrouter", "provider": "openrouter", "tier": "paid", "id_status": "EXISTE", "cli_hints": {"opencode": "openrouter/deepseek/deepseek-v4-flash"}},
        {"id": "claude-sonnet-5", "provider": "anthropic", "tier": "paid", "id_status": "EXISTE"},
        {"id": "gemini-3.6-flash", "provider": "google", "tier": "paid", "id_status": "PROVAVEL"}
      ]
    },
    "catalog": {
      "kind": "free-catalog/1",
      "models": [
        {"ref": "google/gemma-4-31b-it:free", "provider": "openrouter", "keyless": false, "context_length": 262144},
        {"ref": "mimo-v2.5-free", "provider": "opencode", "keyless": true, "context_length": null},
        {"ref": "cohere/north-mini-code:free", "provider": "openrouter", "keyless": false, "context_length": 256000},
        {"ref": "ghost-model:free", "provider": "openrouter", "keyless": false, "context_length": 999999},
        {"ref": "nemotron-3-ultra-free", "provider": "opencode", "keyless": true, "context_length": null}
      ]
    },
    "allowlist": {"providers": ["opencode", "openrouter"]}
  },
  "cases": [
    {
      "name": "cheap_with_openrouter_credential",
      "incident": "E5-M4/R1 ordering; E5-M2 dead id skipped",
      "request": "tier:cheap",
      "credentials": ["openrouter"],
      "expect": {
        "ok": {
          "entries": [
            {"ref": "mimo-v2.5-free", "id_status": "EXISTE", "provider": "opencode", "keyless": true},
            {"ref": "nemotron-3-ultra-free", "id_status": "EXISTE", "provider": "opencode", "keyless": true},
            {"ref": "google/gemma-4-31b-it:free", "id_status": "EXISTE", "provider": "openrouter", "keyless": false},
            {"ref": "cohere/north-mini-code:free", "id_status": "EXISTE", "provider": "openrouter", "keyless": false}
          ],
          "skipped": [
            {"ref": "ghost-model:free", "reason": {"DeadId": {"id_status": "FANTASMA"}}}
          ]
        }
      }
    },
    {
      "name": "cheap_zero_key_only",
      "incident": "E5-M5: keyed refs skipped without file credential; keyless leg survives",
      "request": "tier:cheap",
      "credentials": [],
      "expect": {
        "ok": {
          "entries": [
            {"ref": "mimo-v2.5-free", "id_status": "EXISTE", "provider": "opencode", "keyless": true},
            {"ref": "nemotron-3-ultra-free", "id_status": "EXISTE", "provider": "opencode", "keyless": true}
          ],
          "skipped": [
            {"ref": "ghost-model:free", "reason": {"DeadId": {"id_status": "FANTASMA"}}},
            {"ref": "google/gemma-4-31b-it:free", "reason": {"NoFileCredential": {"provider": "openrouter"}}},
            {"ref": "cohere/north-mini-code:free", "reason": {"NoFileCredential": {"provider": "openrouter"}}}
          ]
        }
      }
    },
    {
      "name": "cheap_without_catalog_is_loud",
      "incident": "E5: never degrade to hardcoded defaults",
      "request": "tier:cheap",
      "credentials": ["openrouter"],
      "catalog": null,
      "expect": {"error": "CatalogMissing"}
    },
    {
      "name": "cheap_all_dead_is_loud",
      "incident": "E5-M2: zero live ref = exit 2",
      "request": "tier:cheap",
      "credentials": ["openrouter"],
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "ghost-model:free", "provider": "openrouter", "keyless": false, "context_length": 1}
      ]},
      "expect": {"error": "NoLiveRef"}
    },
    {
      "name": "cheap_keyed_only_no_credential_is_loud",
      "incident": "E5-M5: empty after credential gate",
      "request": "tier:cheap",
      "credentials": [],
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "google/gemma-4-31b-it:free", "provider": "openrouter", "keyless": false, "context_length": 262144}
      ]},
      "expect": {"error": "EmptyAfterCredentialGate"}
    },
    {
      "name": "cheap_provider_outside_allowlist_is_loud",
      "incident": "E5-M6/R4: tampered allowlist/catalog is a violation, not a fallback",
      "request": "tier:cheap",
      "credentials": ["openrouter"],
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "mimo-v2.5-free", "provider": "opencode", "keyless": true, "context_length": null},
        {"ref": "some/paid-model", "provider": "paidcorp", "keyless": false, "context_length": 1}
      ]},
      "expect": {"error": "ProviderOutsideAllowlist"}
    },
    {
      "name": "expensive_outside_catalog_typed_unknown_provider",
      "incident": "e82f008: expensive resolves a ref outside the free catalog; provider is None and keyless=true, never the text '1'",
      "request": "tier:expensive",
      "credentials": [],
      "expect": {
        "ok": {
          "entries": [
            {"ref": "deepseek-v4-pro", "id_status": "EXISTE", "provider": null, "keyless": true}
          ],
          "skipped": []
        }
      }
    },
    {
      "name": "mid_prefers_deepseek_v4_pro",
      "incident": "resolve_tier port: registry-first rule",
      "request": "tier:mid",
      "credentials": [],
      "expect": {"ok": {"entries": [{"ref": "deepseek-v4-pro", "id_status": "EXISTE", "provider": null, "keyless": true}], "skipped": []}}
    },
    {
      "name": "vision_default_when_registry_empty",
      "incident": "resolve_tier port: stamped defaults",
      "request": "tier:vision",
      "credentials": [],
      "registry": {"models": []},
      "expect": {"ok": {"entries": [{"ref": "gemini-3.6-flash", "id_status": "", "provider": null, "keyless": true}], "skipped": []}}
    },
    {
      "name": "unknown_tier_is_loud",
      "incident": "resolve_tier port: no silent tier",
      "request": "tier:ultra",
      "credentials": [],
      "expect": {"error": "NoModelForTier"}
    },
    {
      "name": "direct_id_with_fallback_and_statuses",
      "incident": "run-with-fallback direct path: fallbacks carry stamped status",
      "request": "deepseek-v4-pro",
      "credentials": [],
      "expect": {"ok": {"entries": [
        {"ref": "deepseek-v4-pro", "id_status": "EXISTE", "provider": "deepseek", "keyless": true},
        {"ref": "deepseek-v4-flash-openrouter", "id_status": "EXISTE", "provider": "openrouter", "keyless": true}
      ], "skipped": []}}
    },
    {
      "name": "direct_cli_hint_resolves_to_id",
      "incident": "run-with-fallback direct path: cli_hints values are aliases",
      "request": "openrouter/deepseek/deepseek-v4-flash",
      "credentials": [],
      "expect": {"ok": {"entries": [
        {"ref": "deepseek-v4-flash-openrouter", "id_status": "EXISTE", "provider": "openrouter", "keyless": true}
      ], "skipped": []}}
    },
    {
      "name": "direct_unknown_model_is_loud",
      "incident": "registry-with-model-id-inexistente (2026-07-25)",
      "request": "does-not-exist",
      "credentials": [],
      "expect": {"error": "UnknownModel"}
    },
    {
      "name": "T05_empty_registry_cheap",
      "incident": "T05 registry-1: registry {} is an empty registry, not an error; cheap chain forms with id_status \"\" (and the dead gate never fires)",
      "request": "tier:cheap",
      "credentials": ["openrouter"],
      "registry": {"models": []},
      "expect": {
        "ok": {
          "entries": [
            {"ref": "mimo-v2.5-free", "id_status": "", "provider": "opencode", "keyless": true},
            {"ref": "nemotron-3-ultra-free", "id_status": "", "provider": "opencode", "keyless": true},
            {"ref": "ghost-model:free", "id_status": "", "provider": "openrouter", "keyless": false},
            {"ref": "google/gemma-4-31b-it:free", "id_status": "", "provider": "openrouter", "keyless": false},
            {"ref": "cohere/north-mini-code:free", "id_status": "", "provider": "openrouter", "keyless": false}
          ],
          "skipped": []
        }
      }
    },
    {
      "name": "T05_direct_empty_id_is_malformed_not_chain",
      "incident": "T05 registry-3: a registry entry missing id has id \"\"; direct request \"\" must never become a chain with an empty ref — typed MalformedField (not UnknownModel; Decisions 2026-09-19)",
      "request": "",
      "credentials": [],
      "registry": {"models": [{"provider": "zen", "tier": "free", "id_status": "EXISTE"}]},
      "expect": {"error": "MalformedField"}
    },
    {
      "name": "T05_cli_hints_non_string_ignored",
      "incident": "T05 registry-6: cli_hints with nested objects/numbers parse without crashing and never alias; only string values are aliases (request resolves by id)",
      "request": "m1",
      "credentials": [],
      "registry": {"models": [{"id": "m1", "cli_hints": {"opencode": {"nested": {"deep": "x/y"}}, "num": 7}}]},
      "expect": {"ok": {"entries": [{"ref": "m1", "id_status": "", "provider": null, "keyless": true}], "skipped": []}}
    },
    {
      "name": "T05_duplicate_id_last_status_wins",
      "incident": "T05 registry-7: duplicate registry ids — the LAST id_status wins (status_map last-write), deterministically; here FANTASMA last kills the ref (NoLiveRef)",
      "request": "tier:cheap",
      "credentials": [],
      "registry": {"models": [{"id": "dup", "id_status": "EXISTE"}, {"id": "dup", "id_status": "FANTASMA"}]},
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "dup", "provider": "opencode", "keyless": true, "context_length": null}
      ]},
      "expect": {"error": "NoLiveRef"}
    },
    {
      "name": "T05_duplicate_ref_keeps_both_legs",
      "incident": "T05 catalog-13: two catalog entries with the same ref but different keyless BOTH enter the chain (parity with Python sorted, which keeps both); dedup is a candidate law, not a law yet",
      "request": "tier:cheap",
      "credentials": ["openrouter"],
      "registry": {"models": [{"id": "dup", "id_status": "EXISTE"}]},
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "dup", "provider": "openrouter", "keyless": false, "context_length": 1000},
        {"ref": "dup", "provider": "opencode", "keyless": true, "context_length": null}
      ]},
      "expect": {
        "ok": {
          "entries": [
            {"ref": "dup", "id_status": "EXISTE", "provider": "opencode", "keyless": true},
            {"ref": "dup", "id_status": "EXISTE", "provider": "openrouter", "keyless": false}
          ],
          "skipped": []
        }
      }
    },
    {
      "name": "T05_ref_with_us_delimiter_is_malformed",
      "incident": "T05 catalog-14 / L1b end-to-end: a catalog ref containing \\u001f is a typed MalformedField (CLI: exit 2, stdout empty), never a chain",
      "request": "tier:cheap",
      "credentials": [],
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "a\u001fb", "provider": "opencode", "keyless": true, "context_length": null}
      ]},
      "expect": {"error": "MalformedField"}
    },
    {
      "name": "T05_ref_with_newline_is_malformed",
      "incident": "T05 catalog-15 / L1b end-to-end: a catalog ref containing \\n is a typed MalformedField (CLI: exit 2, stdout empty), never a chain",
      "request": "tier:cheap",
      "credentials": [],
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "a\nb", "provider": "opencode", "keyless": true, "context_length": null}
      ]},
      "expect": {"error": "MalformedField"}
    },
    {
      "name": "T05_empty_provider_is_allowlist_violation",
      "incident": "T05 catalog-16 divergence vs shell: provider \"\" (empty string, not null) is Some(\"\") in Rust and fails the allowlist loudly; run-with-fallback.sh coerces \"\" to no provider (m.get(\"provider\") or \"\") and skips the credential gate. Rust behaviour pinned here (Decisions 2026-09-19)",
      "request": "tier:cheap",
      "credentials": ["opencode", "openrouter"],
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "m", "provider": "", "keyless": false, "context_length": null}
      ]},
      "expect": {"error": "ProviderOutsideAllowlist"}
    },
    {
      "name": "T05_empty_allowlist_keyless_providerless",
      "incident": "T05 allowlist-17: empty allowlist makes every provider-bearing entry a violation (keyless with Some(provider) included); only a keyless entry with provider null still forms a chain",
      "request": "tier:cheap",
      "credentials": [],
      "allowlist": {"providers": []},
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "anon", "provider": null, "keyless": true, "context_length": null}
      ]},
      "expect": {"ok": {"entries": [{"ref": "anon", "id_status": "", "provider": null, "keyless": true}], "skipped": []}}
    },
    {
      "name": "T05_allowlist_whitespace_not_trimmed",
      "incident": "T05 allowlist-18: allowlist providers are matched verbatim — \"openrouter \" (trailing space) does not cover \"openrouter\" and is a violation; duplicates are harmless (BTreeSet)",
      "request": "tier:cheap",
      "credentials": ["openrouter"],
      "allowlist": {"providers": ["opencode", "openrouter "]},
      "catalog": {"kind": "free-catalog/1", "models": [
        {"ref": "g", "provider": "openrouter", "keyless": false, "context_length": 1}
      ]},
      "expect": {"error": "ProviderOutsideAllowlist"}
    }
  ]
}
