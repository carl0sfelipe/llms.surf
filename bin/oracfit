#!/bin/bash
# oracfit — CLI router v1 (usage-derived aliases + terreno custom)
# Motor: bin/dispatch-mode.sh · Panel: bin/oracfit-panel.sh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cmd="${1:-help}"
shift || true

did_you_mean() {
  cat >&2 <<EOF
Oracfit (ex-Dispatch) — '$1' não é subcomando conhecido.

Uso base:
  oracfit start | first-proof
  oracfit run normal <spec> <task>
  oracfit status --task <nome>   # veredito canônico (regra 53)
  oracfit panel

Custom (ouro):
  oracfit run <mode_id> <spec|input_dir> <task>
  oracfit modes
  oracfit mode validate <id|path.yaml>
  oracfit mode init <id>

Aliases de surf (mesmos modos, nome de onda): paddle | tow | surfcheck
  → oracfit alias

Legado equivalente: bin/dispatch-mode.sh <mode> …

ARCH/COPY não são modes — classify recusa modelo.
Painel = observe-only. stop/rerun = CLI reservado (AD-14).
Oracfit — Carlos Felipe
EOF
}

lifecycle_reserved() {
  cat >&2 <<EOF
Oracfit: '$1' está reservado (lifecycle CLI, AD-8/AD-14).
Painel não executa stop/rerun. Por enquanto:
  - parar run ativo: Ctrl+C no terminal do runner
  - rerun: oracfit run <mode> …  (novo run_id)
Ver: _bmad-output/planning-artifacts/v1-modes-catalog.md
EOF
  exit 2
}

# Aliases de surf (go-live D2, 2026-08-29): os ids do tree ficam — normal,
# unlock_plan e ui_visual_qa continuam sendo os nomes canônicos em YAML, ledger
# e testes. A UI (CLI + TUI) também aceita o nome de surf. Mapa ÚNICO; quem
# quiser um terceiro nome cria alias, nunca um modo-irmão (colisão de id é
# incidente — ver lint de shadow no loader).
MODE_ALIASES="paddle=normal tow=unlock_plan surfcheck=ui_visual_qa"

resolve_mode_alias() { # <nome> → imprime o id canônico do tree
  local pair name="$1"
  for pair in $MODE_ALIASES; do
    case "$pair" in "$name="*) printf '%s\n' "${pair#*=}"; return 0 ;; esac
  done
  printf '%s\n' "$name"
}

cmd_alias() {
  # `oracfit alias` sem arg: imprime o mapa. Com arg: resolve UM nome —
  # alias conhecido, id de modo existente (root ou workdir), ou erro.
  local root_dir workdir_dir
  root_dir="${ORACFIT_ROOT:-$ROOT}/core/modes"
  workdir_dir="${ORACFIT_WORKDIR:-$PWD}/core/modes"
  if [ "$#" -eq 0 ]; then
    local pair
    for pair in $MODE_ALIASES; do
      printf '%s\n' "$pair"
    done
    return 0
  fi
  local name target
  for name in "$@"; do
    target="$(resolve_mode_alias "$name")"
    if [ -f "$workdir_dir/$target.yaml" ] || [ -f "$root_dir/$target.yaml" ]; then
      printf '%s\n' "$target"
    else
      echo "ERROR: unknown mode or alias: $name" >&2
      return 2
    fi
  done
}

cmd_help() {
  cat <<EOF
Oracfit (ex-Dispatch) — CLI v1

BASE
  oracfit start                         # first-proof (stub se DISPATCH_RUNNER=stub)
  oracfit first-proof
  oracfit run normal <spec> <task>      # modo base Flash-class
  oracfit status --task <nome>          # veredito canônico do último run da
                                        #   task neste workdir (JSON, regra 53)
  oracfit batch <batch_file>            # N itens (spec|task|dir[|model]) com
                                        # checkpoint+rollback — NUNCA loop à mão
                                        # (incidente 2026-08-11-hand-rolled-loop)
  oracfit panel [--workdir DIR] [--port N]
  oracfit gui [--target DIR] [--port N] [--owner-actions PATH]
  oracfit gui-tunnel --auth-token SEGREDO [--target DIR] [--enable-dispatch]
                                           # link https p/ celular (cloudflared)
  oracfit hitl <target-dir> [--port N]      # calibração: nota real 0-10 por anel
  oracfit verify <spec> <task> [--before]  # direct mode: the orchestrator
                                        #   implements; red→green oracle in
                                        #   the ledger/panel, no model call
  oracfit roi [--workdir DIR]... [--since YYYY-MM-DD] [--json]
                                        # cost and hit rate per executor
  oracfit delegation-check --deliverable-lines N --executor <id>
                                        # worth delegating? run BEFORE writing
                                        #   the spec (exit 10 = do it directly)
  oracfit acao add <id> --title T --plain P # pedido de agente ao dono (GUI)
  oracfit acao list [--json] | done <id> | snooze <id> <horas>

  oracfit resume <run_id> "<mensagem>"   # retoma run terminado/pausado
                                         # (multi-stage incluso; responde a
                                         # pergunta do dono — status
                                         # owner_question, exit 7)

CUSTOM (terreno v1 · runtime multi-stage = v2)
  oracfit modes
  oracfit alias [nome]               # mapa de aliases de surf / resolve um
                                     #   paddle=normal tow=unlock_plan
                                     #   surfcheck=ui_visual_qa
  oracfit mode validate <id|yaml>
  oracfit mode lint <id|yaml>       # v4: claims→mecanismos + shadow de id
  oracfit mode init <id> [--from <mode|alias>]  # scaffold, or a copy of paddle/tow/any mode
  oracfit mode add <yaml>           # install a shared YAML (validated) in the workdir overlay
  oracfit mode share <id>           # print the YAML ready to post
  oracfit spec init <file.md>       # a spec that already passes the gate; edit and run
  oracfit spec check <file.md>      # the spec gate alone
  # vision_catalog / unlock_plan: YAML shipa; execução map/reduce/unlock → v2

RING (v4 — god mode com mecanismo, não protocolo)
  oracfit ring init --mode <id> [--target DIR] [--oracle-cmd "<cmd>"]
  oracfit ring open  RING-N "hipótese" [--target DIR]
  oracfit ring close RING-N [--target DIR] -- <pathspec...>
  oracfit ring abort RING-N "motivo" | score RING-N --real N | status

DAEMON (v4 — processo longo imune à morte da sessão)
  oracfit daemon start <log> <cmd> [args...]   # double-fork+setsid+pidfile
  oracfit daemon status <log> | stop <log>

CRITIC-GUARD (v4 — critic é read-only por código, não por prompt)
  oracfit critic-guard run   --target DIR [--budget S] -- <cmd>  # write mata (exit 5)
  oracfit critic-guard arm   --target DIR [--budget S]  # antes de dispatch host-mode (Task)
  oracfit critic-guard check --target DIR               # depois: tripwire, drift=quarentena
  oracfit critic-guard status --target DIR

USAGE HUB (v3.5 — tokens/quota built-in, sem daemon)
  oracfit usage status                  # tokens por provider (opencode.db)
  oracfit usage recommend --provider X  # use/wait/exhausted (exit 0/1/4)
  oracfit usage pick --tiers "r1 r2"    # 1º model ref viável p/ subagent
  oracfit usage observe --kind rate_limit --model-ref M
  oracfit usage limits --set opencode 5h 4000000

ROOT vs workdir
  ORACFIT_ROOT = instalação (bin/, panel/, core/modes/)
  workdir      = projeto (.dispatch/logs/)

oracle_exit=2 = oráculo QUEBRADO, não 'falta trabalho'.
Sintaxe completa: _bmad-output/planning-artifacts/v1-modes-catalog.md
Oracfit — Carlos Felipe
EOF
}

cmd_modes() {
  # Workdir overlay first, then ROOT — same resolution order as dispatch-mode.sh
  # (AD-16, v1-modes-catalog.md §4). A workdir mode with the same id as a ROOT
  # mode shadows it in listing, matching what `oracfit run <id>` would actually
  # execute.
  # macOS ships bash 3.2 (no `declare -A`) — use a newline list + grep -xF as
  # the membership check instead of an associative array (same class of bug
  # as `mapfile` earlier: don't assume bash 4+ on this host).
  local root_dir="${ORACFIT_ROOT:-$ROOT}/core/modes"
  local workdir_dir="${ORACFIT_WORKDIR:-$PWD}/core/modes"
  local f id
  local workdir_ids=""

  if [ -d "$workdir_dir" ] && [ "$workdir_dir" != "$root_dir" ]; then
    echo "modes in $workdir_dir (workdir overlay)"
    for f in "$workdir_dir"/*.yaml; do
      [ -f "$f" ] || continue
      id=$(basename "$f" .yaml)
      echo "  $id"
      workdir_ids="$workdir_ids$id"$'\n'
    done
  fi

  echo "modes in $root_dir"
  if [ ! -d "$root_dir" ]; then
    echo "(missing)" >&2
    exit 3
  fi
  for f in "$root_dir"/*.yaml; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .yaml)
    if printf '%s' "$workdir_ids" | grep -qxF "$id"; then
      echo "  $id (shadowed by workdir overlay)"
    else
      echo "  $id"
    fi
  done

  # D2/D7: o CLI lista tudo (god modes inclusive); a TUI e a home mostram só
  # os aliases de surf. Alias é apelido de UI — o id canônico é o do YAML.
  echo "surf aliases (same modes, friendlier names — run: oracfit alias):"
  local pair
  for pair in $MODE_ALIASES; do
    echo "  ${pair%%=*} → ${pair#*=}"
  done
}

resolve_mode_yaml() { # $1=id|path — imprime caminho ou sai 3
  local target="$1"
  local file="$target"
  if [ ! -f "$file" ]; then
    # Workdir overlay first, then ROOT — same order dispatch-mode.sh resolves
    # at run time, so `validate` actually checks what `run` would execute.
    file="${ORACFIT_WORKDIR:-$PWD}/core/modes/${target}.yaml"
  fi
  if [ ! -f "$file" ]; then
    file="${ORACFIT_ROOT:-$ROOT}/core/modes/${target}.yaml"
  fi
  if [ ! -f "$file" ]; then
    echo "ERROR: mode yaml not found: $target (tried ${ORACFIT_WORKDIR:-$PWD}/core/modes/${target}.yaml and ${ORACFIT_ROOT:-$ROOT}/core/modes/${target}.yaml)" >&2
    exit 3
  fi
  echo "$file"
}

cmd_mode_validate() {
  local file
  file=$(resolve_mode_yaml "${1:?usage: oracfit mode validate <id|path.yaml>}")
  exec python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" validate "$file"
}

cmd_mode_lint() {
  local file
  file=$(resolve_mode_yaml "${1:?usage: oracfit mode lint <id|path.yaml>}")
  exec python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" lint "$file" \
    --root "${ORACFIT_ROOT:-$ROOT}" --workdir "${ORACFIT_WORKDIR:-$PWD}"
}

cmd_mode_init() {
  # mode init <id>                 one cheap stage, gauntlet on, grammar in comments
  # mode init <id> --from <mode>   copy of a built-in or of one of your modes (id or surf
  #                                alias: paddle, tow, surfcheck), renamed to <id>
  local id="" from=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from) from="${2:?usage: oracfit mode init <id> [--from <mode|alias>]}"; shift 2 ;;
      *) id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { echo "usage: oracfit mode init <id> [--from <mode|alias>]" >&2; exit 2; }
  case "$id" in
    *[!a-z0-9_]*) echo "ERROR: id must be [a-z0-9_]+" >&2; exit 2 ;;
  esac
  local dir="${ORACFIT_WORKDIR:-$PWD}/core/modes"
  local dest="$dir/${id}.yaml"
  if [ -e "$dest" ]; then
    echo "ERROR: exists $dest" >&2
    exit 3
  fi
  if [ -n "$from" ]; then
    local source_id source_file
    source_id="$(resolve_mode_alias "$from")"
    source_file="$(resolve_mode_yaml "$source_id")" || exit 3
    mkdir -p "$dir"
    # Only the top-level id and name change; stages, gauntlet and comments are kept as they are.
    FROM_ID="$source_id" NEW_ID="$id" python3 - "$source_file" "$dest" <<'PY'
import os, re, sys
text = open(sys.argv[1], encoding="utf-8").read()
new_id, from_id = os.environ["NEW_ID"], os.environ["FROM_ID"]
text, n = re.subn(r"(?m)^id:.*$", f"id: {new_id}", text, count=1)
if n != 1:
    sys.exit(f"ERROR: no top-level id: in {sys.argv[1]}")
text = re.sub(r"(?m)^name:.*$", f"name: {new_id}", text, count=1)
open(sys.argv[2], "w", encoding="utf-8").write(f"# copied from {from_id} by: oracfit mode init {new_id} --from {from_id}\n" + text)
PY
  else
    mkdir -p "$dir"
    cat >"$dest" <<EOF
id: ${id}
version: "1"
name: ${id}
description: one honest line about what this mode does
stages:                       # 1..N, run in order; a red stage never starts the next one
  - role: run                 # unlock | plan | run | map | reduce
    model_ref: tier:cheap     # tier:cheap | tier:mid | tier:expensive | tier:vision
    oracle: true              # the gate is the command in your spec (## Oracle)
    max_attempts: 3
  # A stage with no model at all:
  # - role: run
  #   command: bash scripts/build.sh
  # A second stage that reads what the first one wrote:
  # - role: run
  #   model_ref: tier:cheap
  #   input: prev_stage
  #   oracle: true
gauntlet:                     # retry loop: the oracle's failure goes into the next attempt
  enabled: true
  inject_feedback: true
  until_approved: true
  safety_ceiling: 5           # hard stop
on_fail: halt
EOF
  fi
  python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" validate "$dest" >/dev/null \
    || { echo "ERROR: scaffold does not validate: $dest" >&2; exit 3; }
  echo "wrote $dest"
  echo "next: oracfit spec init task.md && oracfit run ${id} task.md <task>"
}

cmd_spec_init() {
  # spec init <file>: a spec that already passes the gate (bin/check-spec.sh). The oracle is
  # red on purpose until the work exists; edit the task, the verified data and the command.
  local dest="${1:?usage: oracfit spec init <file.md>}"
  if [ -e "$dest" ]; then
    echo "ERROR: exists $dest" >&2
    exit 3
  fi
  cat >"$dest" <<'EOF'
# Task: one line saying what must exist when this is done

## Task

Say exactly which files to create or change, with their paths.

## Rules

Do not invent numbers, dates, names or sources beyond the ones listed in this spec.
A value that was not decided is written [TO DEFINE], never left blank and never guessed.
Never use declare const or an empty stub as a workaround: import and implement for real.

## Verified data

- List here every fact the model may use. A file path written between backticks is
  checked against the workdir before any model is called.

## Oracle

- command: test -f result.txt && grep -q done result.txt
- expected exit: 0

The command is raw text, with no backticks around it. It must fail before the work exists
(exit 1, not a broken command) and pass after it.

## Verification

VERIFICATION: grep -q done result.txt
EOF
  echo "wrote $dest"
  echo "next: edit it, then: oracfit run paddle $dest <task>"
}

cmd_mode_add() {
  # Install a mode someone shared (the YAML file is the public form of a mode). It is validated
  # and linted with the loader the run uses, then copied to the workdir overlay only.
  local src="${1:?usage: oracfit mode add <path.yaml>}"
  [ -f "$src" ] || { echo "ERROR: yaml not found: $src" >&2; exit 3; }
  python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" validate "$src" || exit $?
  local id
  id="$(grep -E '^id:' "$src" | head -1 | sed 's/^id:[[:space:]]*//' | tr -d '"' | tr -d "'" | tr -d '[:space:]')"
  case "$id" in
    *[!a-z0-9_]*|"") echo "ERROR: no valid top-level id ([a-z0-9_]+) in $src" >&2; exit 2 ;;
  esac
  # The lint compares the id with the file name, so it runs on a copy named after the id.
  local staging
  staging="$(mktemp -d)"
  cp "$src" "$staging/${id}.yaml"
  python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" lint "$staging/${id}.yaml" \
    --root "${ORACFIT_ROOT:-$ROOT}" --workdir "${ORACFIT_WORKDIR:-$PWD}" || { rm -rf "$staging"; exit 2; }
  rm -rf "$staging"
  local dir="${ORACFIT_WORKDIR:-$PWD}/core/modes"
  mkdir -p "$dir"
  local dest="$dir/${id}.yaml"
  if [ -e "$dest" ]; then
    if diff -q "$src" "$dest" >/dev/null 2>&1; then
      echo "already installed (identical): $dest"
      return 0
    fi
    echo "ERROR: $dest exists with DIFFERENT content. Remove it or pick another id; a mode is never overwritten silently." >&2
    exit 3
  fi
  cp "$src" "$dest"
  echo "installed: $dest"
  echo "next: oracfit run ${id} <spec> <task>"
}

cmd_mode_share() {
  # Print the YAML ready to post. Nothing is sent anywhere: sharing is the act of posting it.
  local id="${1:?usage: oracfit mode share <id>}"
  local file
  file=$(resolve_mode_yaml "$(resolve_mode_alias "$id")")
  cat <<EOF
# mode share: paste this whole YAML in a public issue:
#   https://github.com/carl0sfelipe/llms.surf/issues/new?template=share-your-break.md
# Whoever receives it saves the block to any file and runs: oracfit mode add <file>
# Read it once more before posting: a YAML is public text and must hold no secret
# (API keys live in the environment, never in model_ref).
# ─────────────────────────── 8< ───────────────────────────
EOF
  cat "$file"
}

cmd_run() {
  local mode="${1:?usage: oracfit run <mode> <spec|input> <task>}"
  shift
  # Alias de surf resolve aqui (única porta de entrada da UI): o runtime
  # (dispatch-mode/dispatch-stages) só vê id canônico — YAML, ledger e eventos
  # continuam gravando o id do tree (D2).
  mode="$(resolve_mode_alias "$mode")"
  # P5: multi-stage modes (unlock_plan, vision_catalog, …) use dispatch-stages.sh
  local mode_yaml stage_n has_command
  mode_yaml="${ORACFIT_WORKDIR:-$PWD}/core/modes/${mode}.yaml"
  [ -f "$mode_yaml" ] || mode_yaml="${ROOT}/core/modes/${mode}.yaml"
  stage_n=1
  has_command=0
  if [ -f "$mode_yaml" ]; then
    stage_n=$(python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" dump "$mode_yaml" 2>/dev/null | python3 -c 'import json,sys; print(len((json.load(sys.stdin).get("stages") or [])))' 2>/dev/null || echo 1)
    # A stage that declares its own command is mechanical: it runs that command,
    # no model. dispatch-mode.sh only dispatches models, so a single mechanical
    # stage has to go through dispatch-stages.sh too — otherwise the mode calls
    # an LLM where the author asked for a script.
    has_command=$(python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" dump "$mode_yaml" 2>/dev/null | python3 -c 'import json,sys; print(1 if any((s or {}).get("command") for s in (json.load(sys.stdin).get("stages") or [])) else 0)' 2>/dev/null || echo 0)
  fi
  if [ "${stage_n:-1}" -gt 1 ] 2>/dev/null || [ "${has_command:-0}" -eq 1 ] 2>/dev/null; then
    exec "$SCRIPT_DIR/dispatch-stages.sh" "$mode" "$@"
  fi
  exec "$SCRIPT_DIR/dispatch-mode.sh" "$mode" "$@"
}

cmd_status() {  # S7 (regra 53, mecanismo 2): a superfície CANÔNICA de veredito.
  # Um JSON do run MAIS RECENTE com esse task name neste workdir, lido dos
  # arquivos que o dispatcher já grava (inbox/<run_id>.task-name +
  # logs/events.jsonl). Grep cru em events.jsonl deixa de ser caminho de
  # decisão — foi assim que um pass de run ANTERIOR foi lido como veredito
  # (incidente 2026-08-27, regra 53).
  local task="${1:?uso: oracfit status --task <nome>}"
  local wd="${ORACFIT_WORKDIR:-$PWD}"
  python3 - "$task" "$wd" <<'PY'
import json, os, sys
task, wd = sys.argv[1], sys.argv[2]
inbox = os.path.join(wd, ".dispatch", "logs", "inbox")
events = os.path.join(wd, ".dispatch", "logs", "events.jsonl")
best = None
try:
    for name in os.listdir(inbox):
        if not name.endswith(".task-name"):
            continue
        rid = name[:-len(".task-name")]
        path = os.path.join(inbox, name)
        try:
            with open(path, encoding="utf-8") as f:
                if f.read() != task:
                    continue
        except OSError:
            continue
        mtime = os.path.getmtime(path)
        if best is None or mtime > best[0]:
            best = (mtime, rid)
except FileNotFoundError:
    pass
if best is None:
    print(json.dumps({"task": task, "status": "not_found"}, ensure_ascii=False))
    sys.exit(3)
rid = best[1]
out = {"task": task, "run_id": rid, "status": "unknown"}
attempts = 0
last_oracle_exit = None
try:
    with open(events, encoding="utf-8") as f:
        for line in f:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if obj.get("run_id") != rid:
                continue
            t = obj.get("type")
            if t == "oracle_result":
                attempts += 1
                if "exit" in obj:
                    last_oracle_exit = obj["exit"]
            elif t == "run_finished":
                out["status"] = obj.get("status", "unknown")
                if "oracle_exit" in obj:
                    last_oracle_exit = obj["oracle_exit"]
except FileNotFoundError:
    pass
out["attempts"] = attempts
out["last_oracle_exit"] = last_oracle_exit
print(json.dumps(out, ensure_ascii=False))
PY
}

cmd_resume() {
  # resume (v1, 2026-08-01): retoma um dispatch JA TERMINADO com uma
  # mensagem nova do humano, reaproveitando a mesma sessao do opencode
  # (preserva cache — ver lessons/2026-08-01-continuidade-de-sessao-hitl-p0-cache.md).
  # Complementa o interrupt do painel (que so funciona em run VIVO); isto
  # funciona em run que ja fechou (pass ou fail).
  local run_id="${1:?usage: oracfit resume <run_id> \"<mensagem>\"}"
  local msg="${2:?usage: oracfit resume <run_id> \"<mensagem>\"}"
  local wd="${ORACFIT_WORKDIR:-$PWD}"
  local inbox_dir="$wd/.dispatch/logs/inbox"
  mkdir -p "$inbox_dir"
  if [ ! -f "$inbox_dir/${run_id}.spec-file" ]; then
    echo "ERROR: run_id $run_id sem spec/mode/task persistidos em $inbox_dir — dispatch original é anterior a esta feature, ou run_id errado" >&2
    exit 3
  fi
  MSG="$msg" python3 -c "
import json, os, sys, time
entry = {'ts': time.time(), 'text': os.environ['MSG'], 'interrupt': False}
with open(sys.argv[1], 'a', encoding='utf-8') as f:
    f.write(json.dumps(entry, ensure_ascii=False) + chr(10))
" "$inbox_dir/${run_id}.jsonl"
  echo "mensagem gravada, retomando run_id=$run_id..."
  # S8/P5: run MULTI-STAGE retoma no runtime multi-stage — antes o resume ia
  # só pro dispatch-mode (1 stage), e a resposta do dono nunca chegava a um
  # run de unlock_plan/vision_catalog (a pergunta do dono dependia disto).
  local mode_id mode_yaml stage_n
  mode_id="$(cat "$inbox_dir/${run_id}.mode-id" 2>/dev/null || true)"
  mode_yaml="$wd/core/modes/${mode_id}.yaml"
  [ -f "$mode_yaml" ] || mode_yaml="${ORACFIT_ROOT:-$ROOT}/core/modes/${mode_id}.yaml"
  stage_n=1
  if [ -f "$mode_yaml" ]; then
    stage_n=$(python3 "$SCRIPT_DIR/lib-oracfit-mode-loader.py" dump "$mode_yaml" 2>/dev/null | python3 -c 'import json,sys; print(len((json.load(sys.stdin).get("stages") or [])))' 2>/dev/null || echo 1)
  fi
  if [ "${stage_n:-1}" -gt 1 ] 2>/dev/null; then
    exec "$SCRIPT_DIR/dispatch-stages.sh" --resume-run-id "$run_id"
  fi
  exec "$SCRIPT_DIR/dispatch-mode.sh" --resume-run-id "$run_id"
}

cmd_first_proof() {
  # No env on a fresh clone: this checkout is the root and the stub is the runner.
  export ORACFIT_ROOT="${ORACFIT_ROOT:-$ROOT}"
  if [ -z "${DISPATCH_RUNNER:-}" ]; then
    export DISPATCH_RUNNER="$ORACFIT_ROOT/adapters/stub/runner.sh"
    echo "no DISPATCH_RUNNER set: using the stub runner (no API key, no model called)" >&2
  fi
  exec "$SCRIPT_DIR/dispatch-mode.sh" normal \
    "${ORACFIT_ROOT}/tests/fixtures/oracfit-smoke-normal.md" \
    "${1:-first-proof}"
}

case "$cmd" in
  help|--help|-h|"") cmd_help ;;
  start|first-proof|tldr|smoke) cmd_first_proof "$@" ;;
  run) cmd_run "$@" ;;
  verify) exec "$SCRIPT_DIR/oracfit-verify.sh" "$@" ;;
  roi) exec python3 "$SCRIPT_DIR/oracfit-roi.py" "$@" ;;
  delegation-check) exec python3 "$SCRIPT_DIR/delegation-check.py" "$@" ;;
  panel|abrir|open) exec "$SCRIPT_DIR/oracfit-panel.sh" "$@" ;;
  gui) exec "$SCRIPT_DIR/oracfit-gui.sh" "$@" ;;
  acao) exec python3 "$SCRIPT_DIR/oracfit-acao.py" "$@" ;;
  gui-tunnel)
    # link público AUTENTICADO p/ celular (cloudflared quick) — exige token
    exec "$SCRIPT_DIR/oracfit-gui-tunnel.sh" "$@" ;;
  hitl)
    # calibração de anel exige alvo com ring/ — o resto da GUI vem junto
    target="${1:?uso: oracfit hitl <target-dir> [--port N]}"
    shift
    exec "$SCRIPT_DIR/oracfit-gui.sh" --target "$target" "$@"
    ;;
  modes) cmd_modes ;;
  alias) cmd_alias "$@" ;;
  spec)
    sub="${1:-}"
    shift || true
    case "$sub" in
      init|new) cmd_spec_init "$@" ;;
      check) exec bash "$SCRIPT_DIR/check-spec.sh" "$@" ;;
      *) echo "usage: oracfit spec init <file.md> | oracfit spec check <file.md>" >&2; exit 2 ;;
    esac
    ;;
  mode)
    sub="${1:-}"
    shift || true
    case "$sub" in
      validate) cmd_mode_validate "$@" ;;
      lint) cmd_mode_lint "$@" ;;
      init) cmd_mode_init "$@" ;;
      add) cmd_mode_add "$@" ;;
      share) cmd_mode_share "$@" ;;
      new) cmd_mode_init "$@" ;;
      list|"") cmd_modes ;;
      *) did_you_mean "mode $sub"; exit 2 ;;
    esac
    ;;
  ring) exec "$SCRIPT_DIR/oracfit-ring.sh" "$@" ;;
  daemon) exec "$SCRIPT_DIR/oracfit-daemon.sh" "$@" ;;
  critic-guard|guard) exec "$SCRIPT_DIR/critic-guard.sh" "$@" ;;
  resume) cmd_resume "$@" ;;
  usage) exec python3 "$SCRIPT_DIR/usage-hub.py" "$@" ;;
  batch) exec "$SCRIPT_DIR/dispatch-batch.sh" "$@" ;;
  status)
    # S7: status --task é o veredito canônico (regra 53) — não é mais
    # lifecycle reservado. Sem --task, continua apontando o reservado.
    if [ "${1:-}" = "--task" ] && [ -n "${2:-}" ]; then
      shift
      cmd_status "$1"
    else
      lifecycle_reserved "status (use: status --task <nome>)"
    fi
    ;;
  stop|rerun|switch|follow|ps) lifecycle_reserved "$cmd" ;;
  normal)
    # leigo: oracfit normal spec task → run normal
    cmd_run normal "$@"
    ;;
  *)
    did_you_mean "$cmd"
    exit 2
    ;;
esac
