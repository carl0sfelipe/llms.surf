# capabilities.env — llama.cpp (llama-server)
# Preenchido a partir de adapters/llamacpp/DISCOVERY.md e da API OpenAI-compatível.
DISPATCH=1
# llama-server é stateless: não guarda sessão entre requisições.
SESSION_REUSE=0
FORK=0
ATTACH_TUI=0
# a API devolve JSON, mas não há flag de formato na invocação (é HTTP, não CLI)
FORMAT_JSON=0

# TOOLS=0 — chamada HTTP de chat completion pura, SEM laco de ferramentas.
# O modelo nao le arquivo nem roda comando: so responde a partir do prompt.
# Comprovado 2026-07-25: tirou 8/8 na suite (prompts autocontidos) e falhou
# na primeira tarefa real que exigia ler o repositorio.
TOOLS=0

# STREAMS_OUTPUT: não verificado neste adapter — trate como não-streaming (conservador).
STREAMS_OUTPUT=0
