# capabilities.env — cursor (cursor-agent)
# Preenchido a partir de adapters/cursor/DISCOVERY.md (`cursor-agent --help`, 2026-08-04).

# `-p/--print` roda prompt headless e sai.
DISPATCH=1

# `--resume [chatId]` no help. Confirmado.
SESSION_REUSE=1

# Sem `--fork` no help. Confirmado ausente.
FORK=0

# Sem attach TUI no contrato de bin/attach.sh.
ATTACH_TUI=0

# `--output-format json` (só com --print). Confirmado.
FORMAT_JSON=1

# TOOLS=1 — `-p` tem write e shell.
TOOLS=1

# STREAMS_OUTPUT=0 — resposta tipicamente no fim (como claude -p).
STREAMS_OUTPUT=0
