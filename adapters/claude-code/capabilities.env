# capabilities.env — claude-code
# Preenchido a partir de adapters/claude-code/DISCOVERY.md (`claude --help`).
# Matriz de referência: specs/PRD-reformulacao-multi-cli.md seção 4.5.

# `-p/--print` roda mensagem única e sai. Confirmado no DISCOVERY.md.
DISPATCH=1

# `-r/--resume [value]` e `--session-id <uuid>` no DISCOVERY.md. Confirmado.
SESSION_REUSE=1

# `--fork-session` (requer --resume ou --continue) no DISCOVERY.md. Confirmado.
FORK=1

# Sem equivalente a `opencode -s <id>`/`opencode attach <url>` no DISCOVERY.md.
# `--resume <id>` reabre em modo interativo, mas com forma de invocação
# incompatível com o contrato de bin/attach.sh (`$DISPATCH_RUNNER -s <id>`).
# Não presumir suporte — marcado 0.
ATTACH_TUI=0

# `--output-format <format>` com choices text|json|stream-json (só com --print)
# no DISCOVERY.md. Confirmado.
FORMAT_JSON=1

# TOOLS=1 — claude -p executa laco agentico.
TOOLS=1

# STREAMS_OUTPUT=0 — `claude -p` imprime a resposta INTEIRA no fim, não durante.
# O watchdog de bin/dispatch.sh mata dispatch com DISPATCH_SILENT_LIMIT segundos
# sem um byte novo no log; calibrado em 300s para o opencode, que faz streaming
# com --print-logs. Aplicado ao claude, mataria toda tarefa honesta que leve mais
# de 5 minutos. Adapter que não streama declara aqui, e o dispatch.sh afrouxa o
# detector de silêncio — o teto absoluto (DISPATCH_TIMEOUT) continua valendo.
STREAMS_OUTPUT=0
