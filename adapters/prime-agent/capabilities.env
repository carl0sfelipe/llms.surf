# capabilities.env — prime-agent
# Preenchido a partir de adapters/prime-agent/DISCOVERY.md (2026-08-13, pós /login).
# Matriz de referência: specs/PRD-reformulacao-multi-cli.md seção 4.5.
# Regra da casa: capacidade só vira 1 com evidência medida no DISCOVERY.md.

# `prime-agent -p [message...]` — one-shot MEDIDO (deepseek-v4-flash → "OK",
# 2.5s; runner + bin/smoke-test.sh passaram com os hints do registry).
DISPATCH=1

# `-r/--resume <path|id>` MEDIDO: recuperou contexto plantado, inclusive
# após SIGKILL no daemon (recuperação de JSONL em disco).
SESSION_REUSE=1

# `--fork <path|id>` MEDIDO: sessão nova herdando contexto, original intocado.
FORK=1

# `prime-agent attach <agent>` MEDIDO: TUI attach/detach/reattach em agent
# vivo, clients 0→1→0, histórico renderizado. Exige pty (EOF sai limpo).
ATTACH_TUI=1

# `--mode json` no --help (também rpc/acp; `--mode daemon` é o SUPERVISOR,
# não run detached — ELOCKED com daemon vivo).
FORMAT_JSON=1

# TOOLS=1 — laço agêntico com IPython persistente, file ops, shell, subagentes.
TOOLS=1

# STREAMS_OUTPUT=1 — modo texto/json emite durante a execução (TUI/daemon).
STREAMS_OUTPUT=1

# ── capacidades além da matriz (diferencial do substrato) ────────────────────
# daemon de background sobrevive ao lançador — MEDIDO (pid==pgid); worker
# RECUPERÁVEL medido: SIGKILL no daemon → respawn + agent/worker recriados
# de daemon-workers/ (command-journal.jsonl + recovery.jsonl + snapshot-cache).
DAEMON=1
# --autonomous + --autonomous-gate <cmd> — MEDIDO segurando o término (gate
# vermelho vira mensagem com o output do gate; retry; exit 0 libera).
# RESSALVA medida: condição de passagem gravável pelo executor SERÁ
# satisfeita pelo executor (ver DISCOVERY, achado classe 4).
AUTONOMOUS_GATE=1
# prime-agent schedule add <agent> <cron|one-time> -- <msg> — one-time
# MEDIDO disparando (delivery na sessão + resposta do modelo + entrada
# consumida). Cron recorrente: só registro medido.
SCHEDULE=1
