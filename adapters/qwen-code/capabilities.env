# capabilities.env — qwen-code
# ⚠️ ADAPTER EXPERIMENTAL: a CLI `qwen` não existe neste host.
# Ver adapters/qwen-code/DISCOVERY.md (Passo 0: `command -v qwen` sem saída).
#
# Sem `qwen --help` real, NENHUMA capacidade pode ser afirmada (PRD seção 11,
# regras 1 e 5). Tudo 0 = bin/ recusa a operação com exit 3 em vez de tentar
# uma flag inventada. Preencher só após rodar o Passo 0 numa máquina com a CLI.

DISPATCH=0
SESSION_REUSE=0
FORK=0
ATTACH_TUI=0
FORMAT_JSON=0

# TOOLS=0 — CLI ausente, nada verificado.
TOOLS=0

# STREAMS_OUTPUT: não verificado neste adapter — trate como não-streaming (conservador).
STREAMS_OUTPUT=0
