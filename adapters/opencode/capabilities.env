# capabilities.env — opencode
# Preenchido a partir de adapters/opencode/DISCOVERY.md (`opencode --help`, `opencode run --help`).
# Matriz de referência: specs/PRD-reformulacao-multi-cli.md seção 4.5.

# `opencode run [message..]` — dispatch de mensagem única. Confirmado no DISCOVERY.md.
DISPATCH=1

# `-c/--continue` e `-s/--session <id>` no `opencode run --help`. Confirmado.
SESSION_REUSE=1

# `--fork` (requer --continue ou --session) no `opencode run --help`. Confirmado.
FORK=1

# `-s, --session` no `opencode --help` (TUI principal) e `opencode attach <url>`. Confirmado.
ATTACH_TUI=1

# `--format` com choices "default"|"json" no `opencode run --help`. Confirmado.
FORMAT_JSON=1

# TOOLS=1 — opencode run executa laco agentico com read/write/bash.
TOOLS=1

# STREAMS_OUTPUT=1 — `opencode run --print-logs` escreve durante a execução, então
# silêncio prolongado é sintoma real de travamento e o detector de 300s vale.
STREAMS_OUTPUT=1
