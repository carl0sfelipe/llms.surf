# capabilities.env — hermes
# Preenchido a partir de adapters/hermes/DISCOVERY.md (`hermes --help`).
# Matriz de referência: specs/PRD-reformulacao-multi-cli.md seção 4.5.

# `-z/--oneshot PROMPT` — "send a single prompt and print ONLY the final
# response text to stdout". Confirmado no DISCOVERY.md.
DISPATCH=1

# `--resume/-r SESSION` — "Resume a previous session by ID or title".
# Confirmado no DISCOVERY.md.
SESSION_REUSE=1

# Sem equivalente a `--fork` no DISCOVERY.md. Existe `--continue [SESSION_NAME]`,
# mas continuar ≠ forkar (fork preserva a base intacta). Não presumir: marcado 0.
# runner.sh recusa --fork com exit 3 em vez de simular via --continue.
FORK=0

# `--tui` existe e `--resume` aceita ID, mas a forma de invocação
# (`hermes --tui --resume <id>`) é incompatível com o contrato de bin/attach.sh,
# que resolve session_id por timestamp de PID file contra o DB do opencode.
# TODO-VERIFICAR: viabilidade de attach real via `hermes --tui -r <id>`.
ATTACH_TUI=0

# `-z/--oneshot` imprime texto final puro ("no session_id line"), sem opção de
# saída estruturada no DISCOVERY.md. `hermes sessions export` exporta JSONL, mas
# é pós-processamento de sessão, não formato de invocação. Marcado 0.
FORMAT_JSON=0

# TOOLS=1 — hermes -z tem toolsets (-t).
TOOLS=1

# STREAMS_OUTPUT: não verificado neste adapter — trate como não-streaming (conservador).
STREAMS_OUTPUT=0
