{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overall_severity",
    "pages",
    "critical_count",
    "major_count",
    "minor_count",
    "top_issues"
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenshot",
        "page_guess",
        "broken_images",
        "css_issues",
        "layout_issues",
        "overall_severity",
        "summary"
      ],
      "properties": {
        "screenshot": { "type": "string" },
        "page_guess": {
          "type": "string",
          "enum": ["pdp", "catalog", "blog", "other"]
        },
        "broken_images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "reason"],
            "properties": {
              "area": { "type": "string" },
              "reason": {
                "type": "string",
                "enum": ["404", "empty", "placeholder", "stretched", "other"]
              }
            }
          }
        },
        "css_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "area", "problem"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["critical", "major", "minor"]
              },
              "area": { "type": "string" },
              "problem": { "type": "string" }
            }
          }
        },
        "layout_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "problem"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["critical", "major", "minor"]
              },
              "problem": { "type": "string" }
            }
          }
        },
        "overall_severity": {
          "type": "string",
          "enum": ["ok", "minor", "major", "critical"]
        },
        "summary": { "type": "string" }
      }
    }
  },
  "properties": {
    "overall_severity": {
      "type": "string",
      "enum": ["ok", "minor", "major", "critical"]
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/finding" }
      }
    },
    "critical_count": { "type": "integer" },
    "major_count": { "type": "integer" },
    "minor_count": { "type": "integer" },
    "top_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problem", "severity", "screenshots"],
        "properties": {
          "problem": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "screenshots": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
